# PLANTILLA. El secret real NUNCA se commitea (k8s/.gitignore lo excluye).
#
# Crealo directamente en el cluster con los valores de tu .env local:
#
#   kubectl -n tapo-guardian create secret generic tapo-guardian-secret \
#     --from-literal=TAPO_USER='<usuario cuenta de camara>' \
#     --from-literal=TAPO_PASSWORD='<password cuenta de camara>' \
#     --from-literal=TELEGRAM_BOT_TOKEN='<token de BotFather>' \
#     --from-literal=TELEGRAM_CHAT_ID='<chat_id[,chat_id2]>'
#
# ArgoCD no gestiona este recurso (no esta en git), asi que `prune: true` no lo
# borra. TAPO_USER va aqui y no en el ConfigMap porque es la mitad de una
# credencial RTSP.
apiVersion: v1
kind: Secret
metadata:
  name: tapo-guardian-secret
  namespace: tapo-guardian
  labels:
    app: tapo-guardian
type: Opaque
stringData:
  TAPO_USER: ""
  TAPO_PASSWORD: ""
  TELEGRAM_BOT_TOKEN: ""
  TELEGRAM_CHAT_ID: ""
