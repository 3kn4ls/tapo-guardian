# IP LOCAL DE LA TAPO TC71
TAPO_IP=192.168.1.50

# Cuenta de cámara creada en la app Tapo:
# Tapo > Cámara > Ajustes > Ajustes avanzados > Cuenta de la cámara
TAPO_USER=tapo
TAPO_PASSWORD=CAMBIA_ESTA_CONTRASEÑA

# 1 = stream principal; 2 = substream
TAPO_STREAM=1

# Token del bot creado con @BotFather
TELEGRAM_BOT_TOKEN=123456789:CAMBIA_ESTE_TOKEN

# Tu chat_id de Telegram. Primero puedes obtenerlo con:
# python tapo_telegram.py --get-chat-id
#
# Admite varios destinos separados por comas. Los grupos llevan signo negativo:
#   TELEGRAM_CHAT_ID=123456789,-987654321
TELEGRAM_CHAT_ID=123456789

# --- Solo para tapo_watch.py (vigilancia de eventos) ---

# Puerto ONVIF de la camara. Se abre al crear la Cuenta de camara.
ONVIF_PORT=2020

# Segundos minimos entre envios. Sin esto el movimiento continuo llena el chat
# y choca con el limite de Telegram (~20 mensajes/minuto a un grupo).
MOTION_COOLDOWN=60

# Detectores que disparan el envio, separados por comas.
# Disponibles en la TC71: Motion, People, Intrusion, LineCross, Tamper, TPSmartEvent
WATCH_EVENTS=Motion,People
